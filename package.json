{
  "name": "mon-hemicycle",
  "version": "0.1.0",
  "private": true,
  "description": "Application mobile (PWA) pour suivre les votes et la présence des députés de l'Assemblée nationale, à partir de l'open data officiel.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:mobile": "tsc --noEmit && vite build --mode mobile && node -e \"require('fs').rmSync('dist/data',{recursive:true,force:true})\"",
    "ios": "npm run build:mobile && cap sync ios && cap open ios",
    "android": "npm run build:mobile && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
